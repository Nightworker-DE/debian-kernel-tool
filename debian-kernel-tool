#!/usr/bin/env python3
import os
import sys
import subprocess
import threading
import gi

# Globale Variable für das Farbschema
user_color_scheme = 0  # 0 = Default, 1 = Prefer Dark, 2 = Prefer Light

def check_root():
    global user_color_scheme

    if os.geteuid() != 0:
        try:
            # Wir lesen den exakten Integer-Wert des GNOME-Farbschemas aus
            # 0: Default, 1: Prefer Dark, 2: Prefer Light
            cmd = ["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"]
            res = subprocess.check_output(cmd, text=True).strip().strip("'")
            if "prefer-dark" in res:
                user_color_scheme = 1
            elif "prefer-light" in res:
                user_color_scheme = 2
        except Exception:
            pass

        script_path = os.path.abspath(sys.argv[0])
        current_env = os.environ.copy()
        display = current_env.get("DISPLAY", ":0")
        xauth = current_env.get("XAUTHORITY", os.path.expanduser("~/.Xauthority"))
        xdg_runtime = current_env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")

        try:
            os.execvp("pkexec", [
                "pkexec",
                "env",
                f"DISPLAY={display}",
                f"XAUTHORITY={xauth}",
                f"XDG_RUNTIME_DIR={xdg_runtime}",
                f"USER_COLOR_SCHEME={user_color_scheme}",
                sys.executable,
                script_path
            ] + sys.argv[1:])
        except Exception as e:
            print(f"Fehler: Root-Rechte konnten nicht erlangt werden: {e}")
            sys.exit(1)
    else:
        # Als Root angekommen: Wir lesen den übergebenen Wert aus
        # WICHTIG: Kein Setzen von os.environ["GTK_THEME"] mehr, um das Theme nicht zu zerstören!
        env_scheme = os.environ.get("USER_COLOR_SCHEME", "0")
        user_color_scheme = int(env_scheme)

check_root()

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Gdk, GLib, Adw

def kernel_sort_key(version_str):
    ver = version_str.replace("linux-image", "").replace("-generic", "").strip("-")
    return [int(c) if c.isdigit() else c for c in repr(ver).split('.')]

class KernelRow(Adw.ActionRow):
    """Eigene Zeile für die Kernel-Liste"""
    def __init__(self, kernel_name):
        super().__init__(title=kernel_name)
        self.kernel_name = kernel_name

        self.check_button = Gtk.CheckButton()
        self.check_button.set_valign(Gtk.Align.CENTER)
        self.add_prefix(self.check_button)
        self.set_activatable_widget(self.check_button)

class KernelManager(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(title="GuideOS Kernel Tool", **kwargs)
        self.set_default_size(600, 500)

        # Haupt-Layout
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_content(self.main_box)

        # Headerbar
        header_bar = Adw.HeaderBar()
        self.main_box.append(header_bar)

        # Status Page / Banner Bereich
        self.toast_overlay = Adw.ToastOverlay()
        self.main_box.append(self.toast_overlay)

        clamp = Adw.Clamp()
        self.toast_overlay.set_child(clamp)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        vbox.set_margin_top(24)
        vbox.set_margin_bottom(24)
        clamp.set_child(vbox)

        # Info-Label
        label = Gtk.Label(
            label="Wählen Sie die zu entfernenden Kernel aus.\n(Aktiver Kernel wird nicht angezeigt)",
            justify=Gtk.Justification.CENTER
        )
        label.add_css_class("caption")
        vbox.append(label)

        # Liste der Kernel
        self.list_box = Gtk.ListBox()
        self.list_box.add_css_class("boxed-list")
        self.list_box.set_selection_mode(Gtk.SelectionMode.NONE)
        vbox.append(self.list_box)

        # Progress & Action Bereich
        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_opacity(0)
        vbox.append(self.progress_bar)

        self.remove_button = Gtk.Button(label="Ausgewählte Kernel entfernen")
        self.remove_button.add_css_class("destructive-action")
        self.remove_button.set_halign(Gtk.Align.CENTER)
        self.remove_button.connect("clicked", self.on_remove_clicked)
        vbox.append(self.remove_button)

        self.populate_kernel_list()

    def populate_kernel_list(self):
        while (child := self.list_box.get_first_child()):
            self.list_box.remove(child)

        try:
            current_kernel = subprocess.check_output(["uname", "-r"]).decode("utf-8").strip()
            cmd = "dpkg -l | grep -E '^(ii|rc)  linux-image-[0-9]' | awk '{print $2}'"
            kernels = subprocess.check_output(cmd, shell=True).decode("utf-8").splitlines()

            available_kernels = [k for k in kernels if current_kernel not in k]

            try:
                available_kernels.sort(key=kernel_sort_key, reverse=True)
            except Exception:
                available_kernels.sort(reverse=True)

            for k in available_kernels:
                row = KernelRow(k)
                self.list_box.append(row)
        except Exception as e:
            print(f"Fehler beim Laden: {e}")

    def on_remove_clicked(self, button):
        to_remove = []
        row = self.list_box.get_first_child()
        while row:
            if isinstance(row, KernelRow) and row.check_button.get_active():
                to_remove.append(row.kernel_name)
            row = row.get_next_sibling()

        if not to_remove:
            self.show_toast("Kein Kernel ausgewählt.")
            return

        self.confirm_dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Tiefenreinigung bestätigen?",
            body=f"Möchten Sie {len(to_remove)} Kernel-Pakete unwiderruflich entfernen?"
        )
        self.confirm_dialog.add_response("cancel", "Abbrechen")
        self.confirm_dialog.add_response("purge", "Jetzt entfernen")
        self.confirm_dialog.set_response_appearance("purge", Adw.ResponseAppearance.DESTRUCTIVE)

        self.confirm_dialog.connect("response", self.on_dialog_response, to_remove)
        self.confirm_dialog.present()

    def on_dialog_response(self, dialog, response, to_remove):
        if response == "purge":
            self.set_ui_busy(True)
            thread = threading.Thread(target=self.run_removal_thread, args=(to_remove,))
            thread.start()
            GLib.timeout_add(100, self.pulse_progress)

    def pulse_progress(self):
        if self.remove_button.get_sensitive():
            self.progress_bar.set_opacity(0)
            return False
        self.progress_bar.pulse()
        return True

    def set_ui_busy(self, busy):
        self.remove_button.set_sensitive(not busy)
        self.list_box.set_sensitive(not busy)
        self.progress_bar.set_opacity(1 if busy else 0)

    def run_removal_thread(self, kernel_list):
        purge_targets = [f"'*{k.replace('linux-image-', '')}*'" for k in kernel_list]
        targets_string = " ".join(purge_targets)
        script = f"export DEBIAN_FRONTEND=noninteractive; apt-get purge -y {targets_string} && apt-get autoremove -y --purge && update-grub"

        try:
            subprocess.run(["bash", "-c", script], check=True)
            GLib.idle_add(self.on_removal_finished, True, "System erfolgreich bereinigt.")
        except subprocess.CalledProcessError:
            GLib.idle_add(self.on_removal_finished, False, "Fehler beim Entfernen der Kernel.")

    def on_removal_finished(self, success, message):
        self.set_ui_busy(False)
        if success:
            self.populate_kernel_list()
        self.show_toast(message)

    def show_toast(self, text):
        toast = Adw.Toast(title=text)
        self.toast_overlay.add_toast(toast)

class KernelApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="com.guideos.kerneltool")

    def do_activate(self):
        style_manager = Adw.StyleManager.get_default()

        # Hier weisen wir Libadwaita sauber an, das echte Theme zu nutzen,
        # OHNE das GTK-Layout zu beschädigen.
        if user_color_scheme == 1:
            style_manager.set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        elif user_color_scheme == 2:
            style_manager.set_color_scheme(Adw.ColorScheme.PREFER_LIGHT)
        else:
            style_manager.set_color_scheme(Adw.ColorScheme.DEFAULT)

        win = KernelManager(application=self)
        win.present()

if __name__ == "__main__":
    app = KernelApp()
    app.run(sys.argv)
